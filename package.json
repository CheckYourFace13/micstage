{
  "name": "openmic",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/run-production-build.mjs",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "npx prisma generate --schema=prisma/schema.prisma",
    "check:env": "node scripts/check-production-env.mjs",
    "check:env:production": "node scripts/check-production-env.mjs --production",
    "audit:open-mic-listings": "node scripts/audit-public-open-mic-listings.mjs",
    "audit:verified-open-mic-evidence": "node scripts/audit-verified-open-mic-evidence.mjs",
    "promote:reviewed-open-mic-listings": "node scripts/promote-reviewed-open-mic-listings.mjs",
    "test:listing-names": "node scripts/check-listing-name-classifier.mjs",
    "test:seo-indexability": "npx tsx scripts/check-seo-indexability.mjs",
    "test:marketing-outreach": "npx tsx scripts/check-marketing-outreach.mjs",
    "test:open-mic-evidence": "node scripts/check-public-open-mic-evidence.mjs",
    "test:instant-claim": "node scripts/check-instant-claim.mjs",
    "test:onboarding": "node scripts/check-onboarding-simplification.mjs",
    "test:product-audit": "node scripts/check-product-audit-p0.mjs",
    "test:open-mic-removal": "node scripts/check-open-mic-self-removal.mjs",
    "test:database-security": "npx tsx scripts/check-database-security.mjs",
    "test:host-multi-venue": "npx tsx scripts/check-host-multi-venue.mjs",
    "test:host-e2e": "npx tsx scripts/host-multi-venue-e2e.mjs",
    "backfill:host-identities": "npx tsx scripts/backfill-host-identities.mjs",
    "audit:claim-invites": "node scripts/audit-historical-claim-invitations.mjs",
    "audit:duplicate-places": "node scripts/analyze-duplicate-google-places.mjs",
    "backup:production": "node scripts/create-production-backup.mjs",
    "backup:production:ps1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-production-backup.ps1",
    "backup:validate": "node scripts/validate-production-backup.mjs",
    "backup:restore-validate": "node scripts/validate-backup-restore-local.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.5.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@sentry/nextjs": "^10.45.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "cheerio": "^1.2.0",
    "jose": "^6.2.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "luxon": "^3.7.2",
    "next": "16.2.11",
    "pg": "^8.20.0",
    "prisma": "^7.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-qr-code": "^2.0.18",
    "resend": "^6.9.4",
    "svix": "^1.99.1",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@types/google.maps": "^3.58.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tz-lookup": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
